{
  "name": "ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preview": "NEXT_DIST_DIR=.next-preview next build",
    "preview": "PDF_RENDER_ORIGIN=http://127.0.0.1:3112 NEXT_DIST_DIR=.next-preview next start -p 3112",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:reset": "tsx src/server/db/reset.ts",
    "disk:check": "tsx scripts/disk-check.ts",
    "demo:prepare": "tsx scripts/prepare-demo.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "0.45.2",
    "next": "15.5.28",
    "playwright-core": "^1.64.1",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "sharp": "^0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
