# --- Paths ---
# SQLite database file. Keep it OUTSIDE the repo in production.
DATABASE_PATH=./data/ops.db
# Photo storage root. PRD §10.1: use a separate volume in production
# (e.g. /var/ops/uploads) so the disk can be resized without a migration.
UPLOADS_DIR=./uploads

# --- Security ---
# 32+ random bytes, base64 or hex. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production
# Optional: dedicated single-IP header OVERWRITTEN by your reverse proxy.
# Keep the Next.js port private; never forward a client-supplied value unchanged.
# Without this, forwarding headers are ignored and signup uses a shared 20/15min
# budget. With it: 5/15min per IP; always capped at 100/15min per server process.
# AUTH_CLIENT_IP_HEADER=x-ops-client-ip

# --- Runtime ---
NODE_ENV=development
# Public base URL, used for absolute links in PDFs etc.
APP_URL=http://localhost:3000
